# Database
DATABASE_URL="mongodb://root:password@localhost:27017/kling?authSource=admin"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="12h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Redis (required for BullMQ job queues)
REDIS_URL="redis://localhost:6379"

# BullMQ Worker Configuration (optional)
BULLMQ_CONCURRENCY=5

# ==========================================
# ENCRYPTION (required in production)
# ==========================================
# Encryption key for secrets at rest (64 hex characters / 32 bytes)
# Generate with: openssl rand -hex 32
# NEVER commit this to version control
ENCRYPTION_KEY=

# Old encryption key (only during key rotation)
# ENCRYPTION_KEY_OLD=

# ==========================================
# LOGGING
# ==========================================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Directory for log files (production only)
# LOGS_DIR=/var/log/kling

# ==========================================
# RATE LIMITING
# ==========================================
# Internal API key for bypassing rate limits (optional)
# INTERNAL_API_KEY=

# NOTE: Provider credentials (Email, SMS, AI) are configured through
# the admin Settings UI, not environment variables.
